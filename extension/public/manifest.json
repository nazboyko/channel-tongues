{
  "manifest_version": 3,
  "name": "Channel Tongues",
  "version": "0.1.0",
  "description": "Translate a video's title and description on your own machine and add them to the video.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Channel Tongues",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:7312/*"
  ],
  "optional_host_permissions": [
    "https://studio.youtube.com/*"
  ]
}
